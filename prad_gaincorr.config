# PRad2 gain-correction configuration
# Key/value pairs are separated by whitespace.

# SCICOMP JOB ACCOUNTING
USER                          acschick
PROJECT                       hallb
TRACK                         production
OS                            el9

# JOB RESOURCES
NCORES                        16
DISK                          250GB
DISK_PER_FILE                 2.2GB
DISK_OVERHEAD                 15GB
RAM                           8GB
TIMELIMIT                     6hrs

# WORKFLOW DEFINITION
WORKFLOW                      prad2_gaincorr_forErik

# JOB BATCHING
# Each job stages this many EVIO files and passes its scratch directory to gainCorr.
FILES_PER_JOB                 100

# ENVIRONMENT AND EXECUTABLE
ENVFILE                       set_env_CUE_modern.csh
GAINCORR_EXEC                 /work/hallb/prad/pcrad/prad2evviewer/build/bin/prad2ana_replay_gainCorr

# GAIN-CORRECTION PARAMETERS
# The executable receives the staged batch's scratch directory as its positional input.
# Output is supplied by OUTDIR_LARGE below as: <OUTDIR_LARGE>/<run>/batch_<index>.
# NCORES above is passed as: -j <NCORES>.

# -f: Limit the number of EVIO files read from the staged input directory.
# Leave commented to process every staged file (normally FILES_PER_JOB files).
#MAX_FILES                    100

# -c: Optional DAQ configuration JSON. If omitted, the executable's default is used.
#DAQ_CONFIG                   /path/to/daq_config.json

# -d: Optional HyCal module-map JSON. If omitted, the executable's default is used.
#HYCAL_MAP                    /path/to/hycal_map.json

# -b: Number of events per internal gain-correction batch.
GAIN_CORR_BATCH               4000

# -r: Optional reference run used by gain correction.
#REFERENCE_RUN                24769

# -s: Save intermediate *_lms.root files instead of deleting them after hadd.
# Set to 1/true/yes/on to pass -s; set to 0/false/no/off to omit it.
GAIN_CORR_SUMMARY             1

# -p: Enable diagnostic plots.
# Set to 1/true/yes/on to pass -p; set to 0/false/no/off to omit it.
GAIN_CORR_PLOTS               0

# -w: Comma-separated additional W-module IDs for plots. Requires GAIN_CORR_PLOTS 1.
#GAIN_CORR_W_MODULES          1,2,3

# FILE INPUT/OUTPUT DIRECTORIES
INDATA_TOPDIR                 /mss/clas12/rg-o/data
OUTDIR_LARGE                  /volatile/hallb/prad/acschick/PRad2/gaincorr_forErik
OUTDIR_SMALL                  /farm_out/acschick/prad2/gaincorr_forErik
