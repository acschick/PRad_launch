# PRad2 gain-correction configuration
# Key/value pairs are separated by whitespace.

# SCICOMP JOB ACCOUNTING
USER                          acschick
PROJECT                       hallb
TRACK                         production
OS                            el9

# JOB RESOURCES
NCORES                        16
DISK                          250GB
DISK_PER_FILE                 2.2GB
DISK_OVERHEAD                 15GB
RAM                           8GB
TIMELIMIT                     6hrs

# WORKFLOW DEFINITION
WORKFLOW                      prad2_gaincorr_forErik

# JOB BATCHING
# Each job stages this many EVIO files and passes its scratch directory to gainCorr.
FILES_PER_JOB                 100

# ENVIRONMENT AND EXECUTABLE
ENVFILE                       set_env_CUE_modern.csh
GAINCORR_EXEC                 /work/hallb/prad/pcrad/prad2evviewer/build/bin/prad2ana_replay_gainCorr

# GAIN-CORRECTION PARAMETERS
GAIN_CORR_BATCH               4000
GAIN_CORR_SUMMARY             1

# FILE INPUT/OUTPUT DIRECTORIES
INDATA_TOPDIR                 /mss/clas12/rg-o/data
OUTDIR_LARGE                  /volatile/hallb/prad/acschick/PRad2/gaincorr_forErik
OUTDIR_SMALL                  /farm_out/acschick/prad2/gaincorr_forErik
