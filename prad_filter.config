# PRad2 Filter Configuration File
# Key/value pairs are separated by white space
# Lines starting with # and empty lines are ignored

# SCICOMP JOB ACCOUNTING
USER                          acschick
PROJECT                       hallb                     # SLURM account
TRACK                         production                # SLURM partition (debug, production, etc.)
OS                            el9

# JOB RESOURCES
NCORES                        1                         # Number of cores
DISK                          30GB                      # Disk space per job
RAM                           4GB                       # RAM per job
TIMELIMIT                     3hrs                      # Time limit per job

# WORKFLOW DEFINITION
WORKFLOW                      prad2_filter_700MeV_chao  # SWIF2 workflow name

# ENVIRONMENT SETUP
ENVFILE                       set_env_CUE_modern.csh

# FILTER EXECUTABLE
FILTER_EXEC                   /work/hallb/prad/acschick/prad2evviewer/build/bin/prad2ana_replay_filter

# FILTER PARAMETERS
CUTS_JSON                     /work/hallb/prad/acschick/prad2evviewer/analysis/cuts/prad2_default.json # -c cuts JSON

# FILE INPUT/OUTPUT DIRECTORIES
# Input: replay output ROOT files (usually on cache/volatile, not MSS)
INDATA_TOPDIR                 /volatile/hallb/prad/acschick/PRad2/replay_output_chao

# Output directories
OUTDIR_LARGE                  /volatile/hallb/prad/acschick/PRad2/filter_output_chao
OUTDIR_SMALL                  /farm_out/acschick/prad2/filter_chao          # For log files
