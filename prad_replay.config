# PRad2 Replay Configuration File
# Key/value pairs are separated by white space
# Lines starting with # and empty lines are ignored

# SCICOMP JOB ACCOUNTING
USER                          acschick
PROJECT                       hallb                   # SLURM account
TRACK                         production              # SLURM partition (debug, production, etc.)
OS                            el9

# JOB RESOURCES
NCORES                        16                      # Number of cores (also used for -j threads parameter)
DISK                          220GB                    # Max disk space (will auto-calculate per batch)
DISK_PER_FILE                 2.5GB                    # Approx disk per input file (for auto-calc)
DISK_OVERHEAD                 15GB                     # Overhead for output + scratch
RAM                           8GB                    # RAM per job
TIMELIMIT                     2hrs                   # Time limit per job

# WORKFLOW DEFINITION
WORKFLOW                      prad2_replay_700MeV_chao       # SWIF2 workflow name

# JOB BATCHING
FILES_PER_JOB                 100                       # Number of .evio files to process per job (1=original behavior, 100+=batched)

# ENVIRONMENT SETUP
ENVFILE                       set_env_CUE_modern.csh

# REPLAY EXECUTABLE
REPLAY_EXEC                   /work/hallb/prad/acschick/prad2evviewer/build/bin/prad2ana_replay_recon

# REPLAY PARAMETERS
GEM_ZERO_SUPPRESSION          5                        # -z GEM zero-suppression threshold override
#PRAD1_MODE                   0                        # -p PRad1 mode (no GEM)  0=off, 1=on
#MAX_FILES                    10                       # -f max files to process
#DAQ_CONFIG                   /path/to/daq_config.json # -D DAQ config JSON
#GEM_PED                      /path/to/gem_ped.json    # -g GEM pedestal JSON

# FILE INPUT/OUTPUT DIRECTORIES
# Data location - use /mss/... for tape (SWIF2 handles jcache automatically)
#                 or use /cache/... or /lustre24/... if already on disk
INDATA_TOPDIR                 /mss/clas12/rg-o/data

# Output directories
OUTDIR_LARGE                  /volatile/hallb/prad/acschick/PRad2/replay_output_chao
OUTDIR_SMALL                  /farm_out/acschick/prad2/replay_chao          # For log files
